[Desktop Entry]
Type=Application
Name=NoviQ
GenericName=Agente de IA para programar
Comment=Crea, prueba y corrige programas con IA gratis o local
Exec=/opt/noviark/NoviQ
Icon=noviark
Terminal=false
Categories=Development;IDE;Utility;
Keywords=IA;AI;agente;programar;ollama;nvidia;
StartupNotify=true
Actions=Detener;

[Desktop Action Detener]
Name=Apagar NoviQ
Exec=/opt/noviark/NoviQ --stop
